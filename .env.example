# Legacy pipeline input/output defaults (the Harness normally sets these).
SENSECLLM_INPUT_FILE=examples/sensor.md
SENSECLLM_OUTPUT_REPORT=runs/default/report.md

# Core model provider.
CHATANYWHERE_API_KEY=
CHATANYWHERE_BASE_URL=https://api.chatanywhere.tech/v1
SENSECLLM_MODEL=deepseek-v3.2
SENSECLLM_CRITIC_ENABLED=true
SENSECLLM_RAG_ENABLED=true
SENSECLLM_CONSTRAINTS_ENABLED=true
SENSECLLM_CRITIC_MODEL=deepseek-v3.2
SENSECLLM_AGENT_TIMEOUT_SECONDS=900
SENSECLLM_RUN_TIMEOUT_SECONDS=3600
SENSECLLM_MAX_AGENT_ATTEMPTS=2
SENSECLLM_MAX_TOTAL_AGENT_ATTEMPTS=24
SENSECLLM_MAX_MODEL_TOKENS=500000
SENSECLLM_MAX_ESTIMATED_COST=0
SENSECLLM_RETRY_BACKOFF_SECONDS=1.0
# Optional pricing snapshot supplied by the operator; no unstable prices are hard-coded.
SENSECLLM_INPUT_COST_PER_MTOK=
SENSECLLM_OUTPUT_COST_PER_MTOK=

# Optional OTLP HTTP trace export (install .[observability]); can target a
# collector feeding your observability backend.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Existing Dify-compatible RAG and chat applications.
DIFY_API_KEY=
DIFY_CHAT_API_KEY=

# Existing local sensor_rag service / SiliconFlow backend.
SENSOR_RAG_URL=http://127.0.0.1:8001/v1/chat-messages
SENSOR_RAG_API_KEY=sensor-rag-local
SILICONFLOW_API_KEY=
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_GENERATION_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Harness storage.
SENSECLLM_RUNS_DIR=runs
SENSECLLM_MEMORY_DB=runs/memory.sqlite3
